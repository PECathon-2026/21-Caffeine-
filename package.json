{
  "name": "theagentoffice",
  "version": "0.3.0",
  "description": "A live pixel-art office for your coding agents. Claude Code, Codex, Command Code, opencode, Cursor, Droid, Qwen Code and Gemini CLI sessions, local or in Daytona, Railway, Vercel and boat sandboxes, become little workers at desks.",
  "type": "module",
  "bin": {
    "theagentoffice": "dist/cli.js",
    "agentoffice": "dist/cli.js",
    "agent-office": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/preview-guild.mjs",
    "test": "node scripts/build.mjs && node --test --test-timeout=120000 --test-force-exit test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/build.mjs",
    "site": "node scripts/build-site.mjs",
    "site:dev": "node scripts/build-site.mjs --dev",
    "preview": "node scripts/preview-guild.mjs",
    "test:guild": "node --test test/web.guild*.test.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "command-code",
    "opencode",
    "cursor",
    "droid",
    "qwen-code",
    "gemini-cli",
    "ai-agents",
    "coding-agents",
    "mcp",
    "sandbox",
    "vercel-sandbox",
    "daytona",
    "railway",
    "pixel-art",
    "visualizer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bas3line/agent-office.git"
  },
  "author": "bas3line (https://github.com/bas3line)",
  "homepage": "https://github.com/bas3line/agent-office#readme",
  "bugs": "https://github.com/bas3line/agent-office/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
